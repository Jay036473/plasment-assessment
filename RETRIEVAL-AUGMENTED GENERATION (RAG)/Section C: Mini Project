@st.cache_resource
def load_embedder():
    return SentenceTransformer("sentence-transformers/all-MiniLM-L6-v2")


def rewrite_prompt(shallow_prompt: str) -> str:
    return (
        f"Role & Persona: Act as an expert subject matter analyst specializing in the context provided.\n"
        f"Context: Use only the retrieved document segments to answer the user query.\n"
        f"Task: Fully address the following user inquiry: '{shallow_prompt}'\n"
        f"Constraints:\n"
        f"  1. Rely strictly on facts directly mentioned in the context.\n"
        f"  2. Do not assume, extrapolate, or introduce outside information.\n"
        f"  3. If the answer cannot be verified by the context, state 'Information not found in context.'\n"
        f"Output Format: Provide a structured, cohesive response with bullet points where applicable."
    )


def calculate_similarity(text1: str, text2: str, embedding_model) -> float:
    e1 = embedding_model.encode(text1, convert_to_tensor=True)
    e2 = embedding_model.encode(text2, convert_to_tensor=True)
    return float(util.cos_sim(e1, e2).item())


def hf_generate(model_id: str, prompt: str, hf_token: str, max_tokens: int = 400) -> str:
    """HuggingFace InferenceClient — updated for conversational task."""
    try:
        client = InferenceClient(model=model_id, token=hf_token)

        # --- NEW CODE: Use conversational (chat) format ---
        messages = [{"role": "user", "content": prompt}]

        response = client.chat_completion(
            messages=messages,
            max_tokens=max_tokens,
            temperature=0.1
        )

        text = response.choices[0].message.content
        return text.strip() if text else "⚠️ Model returned empty response."

    except Exception as e:
        err = str(e)
        if "401" in err or "unauthorized" in err.lower():
            return "❌ Invalid HF Token. Check huggingface.co/settings/tokens"
        elif "503" in err or "loading" in err.lower():
            return "⏳ Model loading... 30 seconds wait કરીને ફરી try કરો."
        elif "429" in err or "rate" in err.lower():
            return "⏳ Rate limit. થોડી seconds wait કરો."
        else:
            return f"❌ HF Error: {err[:200]}"


def claude_chat_response(messages: list, context: str, anthropic_key: str) -> str:
    """Claude-powered chat assistant using document context."""
    client = anthropic.Anthropic(api_key=anthropic_key)

    system_prompt = (
        "You are a helpful RAG (Retrieval-Augmented Generation) assistant. "
        "You have access to a document context. Answer user questions based primarily on "
        "this context. If the answer is not in the context, say so politely and answer from "
        "your general knowledge if appropriate. Be concise, clear, and helpful.\n\n"
        f"DOCUMENT CONTEXT:\n{context[:3000]}"
    ) if context else (
        "You are a helpful AI assistant specialized in explaining RAG systems, "
        "prompt engineering, and LLM evaluation. Be concise and clear."
    )

    # Convert chat history to Anthropic format
    api_messages = []
    for msg in messages:
        api_messages.append({"role": msg["role"], "content": msg["content"]})

    response = client.messages.create(
        model="claude-3-sonnet-20240229",
        max_tokens=600,
        system=system_prompt,
        messages=api_messages
    )

    if response.content:
        return response.content[0].text
    else:
        return "⚠️ Claude તરફથી કોઈ જવાબ મળ્યો નથી."


def score_to_pill(score: float, threshold: float) -> str:
    if score >= threshold + 0.1:
        return f"<span class='score-pill pill-green'>{score:.4f}</span>"
    elif score >= threshold:
        return f"<span class='score-pill pill-yellow'>{score:.4f}</span>"
    else:
        return f"<span class='score-pill pill-red'>{score:.4f}</span>"


