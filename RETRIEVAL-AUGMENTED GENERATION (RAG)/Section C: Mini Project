if uploaded_file is not None:
    embedder = load_embedder()
    pdf_bytes = uploaded_file.read()

    num_pages = 0

    with st.spinner("⚙️ Extracting text layers from PDF..."):
        pdf_reader = pypdf.PdfReader(BytesIO(pdf_bytes))
        num_pages = len(pdf_reader.pages)
        full_text = ""
        for page in pdf_reader.pages:
            t = page.extract_text()
            if t:
                full_text += t + "\n"

    # --- NEW OCR LOGIC ---
    # જો pypdf ને ટેક્સ્ટ ના મળે (એટલે કે ઈમેજ વાળી PDF હોય) તો OCR ચાલુ કરો
    if len(full_text.strip()) < 50:
        st.info(
            "ℹ️ ડિજિટલ ટેક્સ્ટ મળ્યું નથી. સ્કેન કરેલી ઈમેજ PDF હોવાથી OCR ચાલુ થઈ રહ્યું છે... (આમાં થોડો સમય લાગી શકે છે)")

        try:
            full_text = ""
            doc = fitz.open(stream=pdf_bytes, filetype="pdf")
            num_pages = len(doc)

            # પ્રોગ્રેસ બાર બતાવવા માટે
            progress_bar = st.progress(0)
            status_text = st.empty()

            for page_num in range(len(doc)):
                status_text.text(f"🔍 Reading image page {page_num + 1} of {len(doc)}...")
                page = doc.load_page(page_num)
                pix = page.get_pixmap()

                # Pixmap ને PIL Image માં ફેરવો
                img = Image.open(io.BytesIO(pix.tobytes("png")))

                # OCR દ્વારા ઈમેજમાંથી ટેક્સ્ટ કાઢો
                extracted_text = pytesseract.image_to_string(img)
                full_text += extracted_text + "\n"

                # પ્રોગ્રેસ બાર અપડેટ કરો
                progress_bar.progress((page_num + 1) / len(doc))

            status_text.empty()  # પ્રોગ્રેસ ટેક્સ્ટ કાઢી નાખો
            progress_bar.empty()

        except Exception as e:
            st.error(f"❌ OCR ફેલ થયું. ખાતરી કરો કે કમ્પ્યુટરમાં Tesseract-OCR ઇન્સ્ટોલ કરેલું છે. એરર: {e}")
            st.stop()

    if not full_text.strip():
        st.error(
            "❌ આ PDF માંથી કોઈ ટેક્સ્ટ વાંચી શકાયું નથી. કૃપા કરીને બીજી ફાઈલ અપલોડ કરો.")
        st.stop()

    with st.spinner("🔗 Building FAISS vector index..."):
        splitter = RecursiveCharacterTextSplitter(chunk_size=600, chunk_overlap=100)
        chunks = splitter.split_text(full_text)
        hf_emb = HuggingFaceEmbeddings(model_name="sentence-transformers/all-MiniLM-L6-v2")
        vdb = FAISS.from_texts(chunks, hf_emb)
        st.session_state.vector_db = vdb
        st.session_state.retriever = vdb.as_retriever(search_kwargs={"k": 3})
        st.session_state.context_ready = True
        st.session_state.full_context = full_text

    col_a, col_b, col_c = st.columns(3)
    with col_a:
        st.markdown(f"""<div class='chip'>Total Characters<b>{len(full_text):,}</b></div>""", unsafe_allow_html=True)
    with col_b:
        st.markdown(f"""<div class='chip'>Pages Processed<b>{num_pages}</b></div>""", unsafe_allow_html=True)
    with col_c:
        st.markdown(f"""<div class='chip'>Vector Chunks<b>{len(chunks)}</b></div>""", unsafe_allow_html=True)

    st.success("✅ Vector database ready. System online for RAG queries.")

    st.markdown("<hr class='custom-divider'>", unsafe_allow_html=True)

    # ─────────────────────────────────────────────
    # STEP 2 – BENCHMARK ARENA
    # ─────────────────────────────────────────────
    st.markdown("<div class='section-label'>Step 02</div>", unsafe_allow_html=True)
    st.markdown("<div class='section-title'>⚗️ Benchmarking & Evaluation Arena</div>", unsafe_allow_html=True)

    user_query = st.text_input(
        "Enter a query to benchmark:",
        placeholder="e.g., What are the main findings of this document?",
        help="Enter a simple query — the system compares shallow vs. deep prompt responses."
    )

    run_col, _ = st.columns([1, 3])
    with run_col:
        run_btn = st.button("▶ Run Evaluation Benchmark", use_container_width=True, type="primary")

    if run_btn:
        if not hf_token:
            st.error("❌ Please enter your Hugging Face Token in the sidebar.")
        elif not user_query.strip():
            st.error("❌ Please enter a query before running the benchmark.")
        else:
            with st.spinner("🔄 Executing RAG pipeline & quality evaluation..."):
                start = time.time()

                # Retrieve context
                retrieved_docs = st.session_state.retriever.invoke(user_query)
                context_text = "\n".join([d.page_content for d in retrieved_docs])

                # Build prompts
                deep_prompt = rewrite_prompt(user_query)

                shallow_input = f"Context:\n{context_text}\n\nQuery: {user_query}\n\nAnswer:"
                deep_input = f"Context:\n{context_text}\n\nInstructions:\n{deep_prompt}\n\nAnswer:"

                # Generate both responses via Hugging Face
                shallow_output = hf_generate(selected_model_id, shallow_input, hf_token)
                deep_output = hf_generate(selected_model_id, deep_input, hf_token)

                latency = round(time.time() - start, 2)

                # Scoring
                score_s = calculate_similarity(shallow_output, context_text, embedder)
                score_d = calculate_similarity(deep_output, context_text, embedder)

                flag_s = score_s < similarity_threshold
                flag_d = score_d < similarity_threshold

                # Log
                st.session_state.metrics_log.append({
                    "Query": user_query,
                    "Model": selected_display,
                    "Shallow Score": round(score_s, 4),
                    "Deep Score": round(score_d, 4),
                    "Improvement": round(score_d - score_s, 4),
                    "Shallow Hallucinated": flag_s,
                    "Deep Hallucinated": flag_d,
                    "Latency (s)": latency
                })

            # ─── RESULT DISPLAY ───
            col1, col2 = st.columns(2)

            with col1:
                st.markdown("#### 🔵 Shallow Prompt")
                st.markdown(f"<div class='eval-card'>", unsafe_allow_html=True)
                st.caption(f"**Prompt:** `{user_query}`")
                st.text_area("Output:", value=shallow_output, height=190, disabled=True, key="shallow_out")
                pill = score_to_pill(score_s, similarity_threshold)
                st.markdown(f"**Semantic Alignment:** {pill}", unsafe_allow_html=True)
                if flag_s:
                    st.markdown("<div class='status-bad'>⚠️ Hallucination Detected – Score below threshold</div>",
                                unsafe_allow_html=True)
                else:
                    st.markdown("<div class='status-ok'>✅ Contextually Verified</div>", unsafe_allow_html=True)
                st.markdown("</div>", unsafe_allow_html=True)

            with col2:
                st.markdown("#### 🟣 Engineered Deep Prompt")
                st.markdown(f"<div class='eval-card'>", unsafe_allow_html=True)
                st.caption("**Auto-rewritten with role, constraints & output format**")
                st.text_area("Output:", value=deep_output, height=190, disabled=True, key="deep_out")
                pill2 = score_to_pill(score_d, similarity_threshold)
                st.markdown(f"**Semantic Alignment:** {pill2}", unsafe_allow_html=True)
                if flag_d:
                    st.markdown("<div class='status-warn'>⚠️ Hallucination Risk – Verify output manually</div>",
                                unsafe_allow_html=True)
                else:
                    st.markdown("<div class='status-ok'>✅ Contextually Verified</div>", unsafe_allow_html=True)
                st.markdown("</div>", unsafe_allow_html=True)

            delta = score_d - score_s
            delta_str = f"+{delta:.4f}" if delta >= 0 else f"{delta:.4f}"
            color = "#22C55E" if delta >= 0 else "#EF4444"
            st.markdown(
                f"<div style='text-align:center; color:{color}; font-size:0.9rem; margin-top:8px;'>"
                f"⏱ Pipeline latency: <b>{latency}s</b> &nbsp;|&nbsp; Score Δ (Deep−Shallow): <b>{delta_str}</b>"
                f"</div>",
                unsafe_allow_html=True
            )

    # ─────────────────────────────────────────────
    # STEP 3 – HISTORY TABLE & CSV EXPORT
    # ─────────────────────────────────────────────
