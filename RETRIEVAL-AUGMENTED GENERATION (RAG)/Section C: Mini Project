# ─────────────────────────────────────────────
st.markdown("<hr class='custom-divider'>", unsafe_allow_html=True)
st.markdown("<div class='section-label'>Step 04</div>", unsafe_allow_html=True)
st.markdown("<div class='section-title'>💬 Claude AI Chat Assistant</div>", unsafe_allow_html=True)

if not anthropic_key:
    st.warning("🔑 Enter your Anthropic API Key in the sidebar to activate the Chat Assistant.")
else:
    # Chat header
    st.markdown("""
    <div class='chat-wrapper'>
        <div class='chat-header'>
            <div class='chat-dot'></div>
            <span class='chat-title-text'>Claude AI — Document & RAG Assistant</span>
            <span style='margin-left:auto; font-size:0.75rem; color:#818CF8;'>Powered by Claude Sonnet</span>
        </div>
    </div>
    """, unsafe_allow_html=True)

    context_for_chat = st.session_state.get("full_context", "")

    # Display chat history
    if st.session_state.chat_history:
        chat_html = "<div class='chat-body'>"
        for msg in st.session_state.chat_history:
            if msg["role"] == "user":
                chat_html += f"<div class='bubble-user'>👤 {msg['content']}</div>"
            else:
                safe_content = msg['content'].replace('\n', '<br>')
                chat_html += f"<div class='bubble-bot'>🤖 {safe_content}</div>"
        chat_html += "</div>"
        st.markdown(chat_html, unsafe_allow_html=True)
    else:
        st.markdown("""
        <div style='background:#1E293B; border:1px solid #334155; border-radius:12px; padding:24px; text-align:center; color:#475569; margin-top:4px;'>
            <div style='font-size:2rem; margin-bottom:8px;'>🤖</div>
            <div style='font-size:0.9rem;'>Ask anything about your document or RAG concepts!<br>
            <span style='font-size:0.78rem; color:#334155;'>e.g. "Summarize the document" · "What is RAG?" · "Explain prompt engineering"</span>
            </div>
        </div>
        """, unsafe_allow_html=True)

    # Input row
    chat_col1, chat_col2 = st.columns([5, 1])
    with chat_col1:
        user_chat_input = st.text_input(
            "Your message",
            placeholder="Ask Claude about your document or RAG concepts...",
            label_visibility="collapsed",
            key="chat_input_box"
        )
    with chat_col2:
        send_btn = st.button("Send ➤", use_container_width=True)

    btn_col1, btn_col2 = st.columns([1, 5])
    with btn_col1:
        if st.button("🗑️ Clear Chat", use_container_width=True):
            st.session_state.chat_history = []
            st.rerun()

    # Process message
    if send_btn and user_chat_input.strip():
        st.session_state.chat_history.append({"role": "user", "content": user_chat_input.strip()})

        with st.spinner("🤔 Claude is thinking..."):
            try:
                reply = claude_chat_response(
                    st.session_state.chat_history,
                    context_for_chat,
                    anthropic_key
                )
                st.session_state.chat_history.append({"role": "assistant", "content": reply})
            except Exception as e:
                err_msg = f"Error connecting to Claude: {str(e)}"
                st.session_state.chat_history.append({"role": "assistant", "content": err_msg})

        st.rerun()

    # Quick suggestion chips
    st.markdown("""
    <div style='margin-top:12px; display:flex; flex-wrap:wrap; gap:8px;'>
        <span style='font-size:0.75rem; color:#475569;'>Quick asks:</span>
    </div>
    """, unsafe_allow_html=True)

    sugg_cols = st.columns(4)
    suggestions = [
        "Summarize the document",
        "What is RAG?",
        "Explain prompt engineering",
        "What is hallucination in LLMs?"
    ]
    for i, (col, sugg) in enumerate(zip(sugg_cols, suggestions)):
        with col:
            if st.button(sugg, key=f"sugg_{i}", use_container_width=True):
                st.session_state.chat_history.append({"role": "user", "content": sugg})
                with st.spinner("🤔 Thinking..."):
                    try:
                        reply = claude_chat_response(st.session_state.chat_history, context_for_chat, anthropic_key)
                        st.session_state.chat_history.append({"role": "assistant", "content": reply})
                    except Exception as e:
                        st.session_state.chat_history.append({"role": "assistant", "content": f"Error: {str(e)}"})
                st.rerun()

