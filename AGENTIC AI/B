
1. LangGraph: Sequential to Cyclic Graph with Error Correction (Python)
This code shows how to set up a cycle where if an error is detected in the "check_output" node, it routes back to the "generate" node to fix it.

from typing import TypedDict
from langgraph.graph import StateGraph, END

# 1. Define the State
class AgentState(TypedDict):
    prompt: str
    response: str
    error: str

# 2. Define the Nodes (Tasks)
def generate_response(state: AgentState):
    # Imagine calling an LLM here
    draft = "This is the LLM output." 
    return {"response": draft}

def check_for_errors(state: AgentState):
    # Validation logic here
    if "bad word" in state["response"]:
        return {"error": "Contains invalid content"}
    return {"error": "None"}

# 3. Define the Conditional Edge Logic
def route_based_on_error(state: AgentState):
    if state["error"] != "None":
        return "generate" # Route back to generate (Cyclic)
    return "end" # Finish if no error

# 4. Build the Graph
workflow = StateGraph(AgentState)
workflow.add_node("generate", generate_response)
workflow.add_node("validate", check_for_errors)

# Sequential flow first
workflow.set_entry_point("generate")
workflow.add_edge("generate", "validate")

# Cyclic/Conditional routing
workflow.add_conditional_edges(
    "validate",
    route_based_on_error,
    {
        "generate": "generate",
        "end": END
    }
)

# Compile into an application
app = workflow.compile()

2. ReAct Agent: SQLAlchemy vs. Web Search (Python)
Using LangChain, we define two tools. The ReAct agent automatically reads the tool descriptions and decides which one to use based on how ambiguous or specific your query is.

from langchain.agents import initialize_agent, AgentType
from langchain.tools import tool
from langchain_openai import ChatOpenAI

# 1. Define the Tools
@tool
def query_database(sql_query: str) -> str:
    """Use this tool to fetch specific internal user data or structured company records."""
    # SQLAlchemy logic goes here
    return f"Database results for {sql_query}"

@tool
def web_search(query: str) -> str:
    """Use this tool when the query is ambiguous, requires recent news, or general world knowledge."""
    # Web Search API logic goes here
    return f"Search results for {query}"

tools = [query_database, web_search]

# 2. Initialize the ReAct Agent
llm = ChatOpenAI(temperature=0, model="gpt-4")

agent = initialize_agent(
    tools=tools,
    llm=llm,
    agent=AgentType.CHAT_ZERO_SHOT_REACT_DESCRIPTION,
    verbose=True
)

# 3. Test the Autonomous Decision Making
# The agent will choose the DB tool here:
# agent.run("What is the user ID for John Doe in our system?")

# The agent will choose the Web Search tool here:
# agent.run("What are the latest AI trends in 2026?")

