# QUESTION 4: Self-Correction Chain with PydanticOutputParser + OutputFixingParser
# =============================================================================

import json
from typing import List
from pydantic import BaseModel as PydanticModel, Field, validator
from langchain.output_parsers import PydanticOutputParser, OutputFixingParser
from langchain.prompts import PromptTemplate


# Define the strict JSON schema for marketing content
class MarketingContent(PydanticModel):
    headline: str = Field(description="Catchy headline, max 10 words")
    tagline: str = Field(description="Short tagline, max 15 words")
    features: List[str] = Field(description="List of exactly 3 product features")
    call_to_action: str = Field(description="CTA button text, max 5 words")
    target_audience: str = Field(description="Describe the ideal customer")
    tone: str = Field(description="Content tone: professional/casual/urgent/friendly")

    @validator("features")
    def must_have_three_features(cls, v):
        if len(v) != 3:
            raise ValueError("features must contain exactly 3 items")
        return v

    @validator("headline")
    def headline_word_limit(cls, v):
        if len(v.split()) > 10:
            raise ValueError("headline must be 10 words or fewer")
        return v


def self_correction_chain(product_description: str) -> MarketingContent:
    """
    Self-Correction Chain:
    1. PydanticOutputParser: defines the expected JSON schema
    2. LLM generates marketing content
    3. If output is malformed, OutputFixingParser auto-corrects it
    4. Returns validated MarketingContent object
    """
    llm = ChatOpenAI(model="gpt-3.5-turbo", temperature=0.8)

    # Step 1: Create Pydantic parser with schema
    pydantic_parser = PydanticOutputParser(pydantic_object=MarketingContent)

    # Step 2: Wrap with OutputFixingParser for auto-correction
    # If LLM output fails schema validation, this parser asks LLM to fix it
    fixing_parser = OutputFixingParser.from_llm(
        parser=pydantic_parser,
        llm=llm,
        max_retries=3              # retry up to 3 times before failing
    )

    # Step 3: Build prompt with format instructions
    prompt = PromptTemplate(
        template=(
            "You are a professional marketing copywriter.\n"
            "Create compelling marketing content for the following product:\n\n"
            "{product}\n\n"
            "Your response MUST follow this exact format:\n"
            "{format_instructions}"
        ),
        input_variables=["product"],
        partial_variables={
            "format_instructions": pydantic_parser.get_format_instructions()
        }
    )

    # Step 4: Build and run the chain
    chain = prompt | llm | fixing_parser

    result = chain.invoke({"product": product_description})
    return result


