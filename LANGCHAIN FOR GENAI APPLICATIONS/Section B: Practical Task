# QUESTION 1: RAG Pipeline using PyPDFLoader + ChromaDB

from langchain_community.document_loaders import PyPDFLoader
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain_community.vectorstores import Chroma
from langchain_openai import OpenAIEmbeddings, ChatOpenAI
from langchain.chains import RetrievalQA


def rag_pipeline(pdf_path: str, query: str) -> str:
    """
    RAG Pipeline:
    1. Load PDF corporate policy document
    2. Split into chunks
    3. Store in ChromaDB vector store
    4. Retrieve relevant chunks and answer query using LLM
    """
    # Step 1: Load PDF
    loader = PyPDFLoader(pdf_path)
    documents = loader.load()

    # Step 2: Split documents into chunks
    splitter = RecursiveCharacterTextSplitter(
        chunk_size=1000,
        chunk_overlap=200
    )
    chunks = splitter.split_documents(documents)

    # Step 3: Create ChromaDB vector store
    embeddings = OpenAIEmbeddings()
    vectorstore = Chroma.from_documents(
        documents=chunks,
        embedding=embeddings,
        persist_directory="./chroma_db"   # saves to disk
    )

    # Step 4: Build retrieval chain
    llm = ChatOpenAI(model="gpt-3.5-turbo", temperature=0)
    qa_chain = RetrievalQA.from_chain_type(
        llm=llm,
        chain_type="stuff",
        retriever=vectorstore.as_retriever(search_kwargs={"k": 4})
    )

    # Step 5: Run semantic search query
    result = qa_chain.invoke({"query": query})
    return result["result"]

# QUESTION 2: Autonomous Agent with DuckDuckGo Search + LLM Math Tools

from langchain.agents import initialize_agent, AgentType
from langchain_community.tools import DuckDuckGoSearchRun
from langchain.agents import load_tools

def autonomous_agent(question: str) -> str:
    """
    Autonomous Agent:
    - DuckDuckGoSearchRun: searches the internet for current information
    - llm-math: solves math calculations step-by-step
    - Agent decides which tool to use automatically
    """
    llm = ChatOpenAI(model="gpt-3.5-turbo", temperature=0)

    # Tool 1: DuckDuckGo web search
    search_tool = DuckDuckGoSearchRun()

    # Tool 2: LLM Math (uses numexpr for calculations)
    math_tools = load_tools(["llm-math"], llm=llm)

    # Combine all tools
    tools = [search_tool] + math_tools

    # Initialize agent (ZERO_SHOT_REACT_DESCRIPTION = ReAct framework)
    agent = initialize_agent(
        tools=tools,
        llm=llm,
        agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION,
        verbose=True,          # shows reasoning steps
        handle_parsing_errors=True,
        max_iterations=6
    )

    # Run multi-step query
    result = agent.invoke({"input": question})
    return result["output"]


