# QUESTION 3: FastAPI Chatbot with ConversationSummaryBufferMemory
# =============================================================================

from fastapi import FastAPI
from pydantic import BaseModel
from langchain.memory import ConversationSummaryBufferMemory
from langchain.chains import ConversationChain

# Global memory and chain (shared across requests for same session)
_llm_for_memory = ChatOpenAI(model="gpt-3.5-turbo", temperature=0.7)

memory = ConversationSummaryBufferMemory(
    llm=_llm_for_memory,
    max_token_limit=500,       # keeps last N tokens in buffer
    return_messages=True       # returns chat message format
)

conversation_chain = ConversationChain(
    llm=_llm_for_memory,
    memory=memory,
    verbose=False
)

app = FastAPI(title="LangChain Chatbot with Memory")


class ChatRequest(BaseModel):
    message: str


class ChatResponse(BaseModel):
    reply: str
    summary: str


@app.post("/chat", response_model=ChatResponse)
async def chat_endpoint(request: ChatRequest):
    """
    POST /chat
    Body: {"message": "your message here"}
    
    - ConversationSummaryBufferMemory keeps recent messages in buffer
    - Once buffer is full, older messages are summarized (saves tokens)
    - Long-term context is preserved via summaries
    """
    reply = conversation_chain.predict(input=request.message)
    
    # Get current memory summary
    current_summary = memory.moving_summary_buffer or "No summary yet."
    
    return ChatResponse(reply=reply, summary=current_summary)


@app.delete("/chat/reset")
async def reset_memory():
    """Clear conversation memory and start fresh."""
    memory.clear()
    return {"status": "Memory cleared successfully"}


