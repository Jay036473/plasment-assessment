# PART 3: VISUALIZATION SOLUTIONS

# 9. Line Plot
x_q9 = [3, 4, 5, 6]
y_q9 = [1.5, 2, 2.5, 3]
plt.figure(figsize=(10, 6))
plt.subplot(2, 2, 1)
plt.plot(x_q9, y_q9)
plt.title("Q9: Line Plot")
plt.xlabel("X")
plt.ylabel("Y")

# 10. Multi-function Plot
x_q10 = np.arange(0, 6.3, 0.3)
plt.subplot(2, 2, 2)
plt.plot(x_q10, x_q10, "ro", label="x")
plt.plot(x_q10, x_q10**2, "bs", label="x^2")
plt.plot(x_q10, x_q10**3, "g", label="x^3")
plt.plot(x_q10, x_q10**4, ":", label="x^4")
plt.axis([0, 6, 0, 125])
plt.title("Q10: Polynomial Styles")
plt.legend()

# 11. Bar Plot: Height Comparison
