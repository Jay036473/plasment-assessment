all_cat_cols = df.select_dtypes(include=["object", "category"]).columns.tolist()


# Smart exclude: ID-like columns (too many unique values or named 'id')
def is_id_col(col, series):
    if col.lower() in ["id", "index", "row", "rownum", "no", "number", "sno", "sr"]:
        return True
    if series.nunique() == len(series):  # all unique = ID
        return True
    return False


