# TAB 5 – HIERARCHICAL
# ═════════════════════════════════════════════════════════════
with tab5:
    st.markdown('<div class="section-header">Hierarchical Clustering</div>', unsafe_allow_html=True)

    if "X" not in st.session_state:
        st.warning("Please open the 'Elbow Method' tab first.")
        st.stop()

    X = st.session_state["X"]
    X_raw = st.session_state["X_raw"]
    df_orig_h = df.loc[X_raw.index].copy()

    linkage_method = st.selectbox("Linkage Method", ["ward", "complete", "average", "single"], index=0)

    with st.spinner("Generating Dendrogram..."):
        sample_size = min(300, len(X))
        Z = linkage(X[:sample_size], method=linkage_method)

    fig_dend, ax = plt.subplots(figsize=(14, 4.5))
    ax.set_facecolor("#fafbff")
    fig_dend.patch.set_facecolor("#fafbff")
    dendrogram(Z, ax=ax, truncate_mode="lastp", p=30,
               color_threshold=0.7 * max(Z[:, 2]),
               above_threshold_color="#ccc")
    ax.set_title(f"Dendrogram ({sample_size} samples)", fontsize=13, fontweight="bold", color="#4a4a8a")
    ax.set_xlabel("Sample / Cluster size", fontsize=10)
    ax.set_ylabel("Distance", fontsize=10)
    ax.axhline(y=0.7 * max(Z[:, 2]), color="red", linestyle="--", alpha=0.6, label="Cut line")
    ax.legend()
    st.pyplot(fig_dend, use_container_width=True)

    with st.spinner("Performing Agglomerative clustering..."):
        ag = AgglomerativeClustering(n_clusters=n_clusters, linkage=linkage_method)
        ag_labels = ag.fit_predict(X)
        ag_sil = float(silhouette_score(X, ag_labels))

    df_orig_h["Hier_Cluster"] = ag_labels

    km_sil = float(silhouette_score(X, st.session_state.get("km_labels", ag_labels)))
    c1, c2 = st.columns(2)
    c1.metric("K-Means Silhouette", f"{km_sil:.4f}")
    c2.metric("Hierarchical Silhouette", f"{ag_sil:.4f}",
              delta=f"{ag_sil - km_sil:+.4f} vs K-Means")

    if "coords" in st.session_state:
        coords = st.session_state["coords"]
        ax_labels = st.session_state["ax_labels"]
        plot_h = pd.DataFrame(coords, columns=ax_labels)
        plot_h["Cluster"] = ag_labels.astype(str)
        fig_h = px.scatter(plot_h, x=ax_labels[0], y=ax_labels[1],
                           color="Cluster", title=f"Hierarchical Clusters — {use_dr}",
                           color_discrete_sequence=px.colors.qualitative.Vivid, opacity=0.7)
        fig_h.update_layout(height=420)
        st.plotly_chart(fig_h, use_container_width=True)

    # Side-by-side profile
    st.markdown('<div class="section-header">Comparison: K-Means vs Hierarchical</div>', unsafe_allow_html=True)
    pcols = st.session_state.get("profile_cols", feature_pool[:6])
    hier_profile = df_orig_h.groupby("Hier_Cluster")[pcols].mean().round(2)
    hier_profile.index = [f"Cluster {i}" for i in hier_profile.index]

    c1, c2 = st.columns(2)
    c1.markdown("**K-Means Cluster Means**")
    if "profile" in st.session_state:
        c1.dataframe(
            st.session_state["profile"][pcols] if all(c in st.session_state["profile"].columns for c in pcols) else
            st.session_state["profile"],
            use_container_width=True)
    c2.markdown("**Hierarchical Cluster Means**")
