with tab3:
    st.markdown('<div class="section-header">Optimal K — Elbow & Silhouette</div>', unsafe_allow_html=True)

    if not feature_pool:
        st.warning("No numeric features available.")
        st.stop()

    st.markdown("**Select features for clustering:**")
    default_sel = feature_pool[:min(5, len(feature_pool))]
    sel_features = st.multiselect("Features", feature_pool, default=default_sel)

    if len(sel_features) < 2:
        st.warning("Please select at least 2 features.")
        st.stop()

    X_raw = df[sel_features].copy()
    scaler = StandardScaler()
    X = scaler.fit_transform(X_raw)

    k_range = range(2, min(11, len(df) // 10 + 2))
    inertias, silhouettes = [], []

    with st.spinner("Running Elbow analysis..."):
        for k in k_range:
            km = KMeans(n_clusters=k, random_state=42, n_init=10)
            labels = km.fit_predict(X)
            inertias.append(km.inertia_)
            silhouettes.append(silhouette_score(X, labels))

    c1, c2 = st.columns(2)

    fig_e = go.Figure()
    fig_e.add_trace(go.Scatter(x=list(k_range), y=inertias, mode="lines+markers",
                               line=dict(color="#667eea", width=3),
                               marker=dict(size=9, color="#764ba2")))
    fig_e.add_vline(x=n_clusters, line_dash="dash", line_color="red",
                    annotation_text=f"K={n_clusters}", annotation_position="top right")
    fig_e.update_layout(title="Elbow Method — Inertia vs K",
                        xaxis_title="K", yaxis_title="Inertia", height=360)
    c1.plotly_chart(fig_e, use_container_width=True)

    fig_s = go.Figure()
    fig_s.add_trace(go.Scatter(x=list(k_range), y=silhouettes, mode="lines+markers",
                               line=dict(color="#f093fb", width=3),
                               marker=dict(size=9, color="#f5576c")))
    fig_s.add_vline(x=n_clusters, line_dash="dash", line_color="red")
    fig_s.update_layout(title="Silhouette Score vs K",
                        xaxis_title="K", yaxis_title="Score", height=360)
    c2.plotly_chart(fig_s, use_container_width=True)

    best_k = list(k_range)[np.argmax(silhouettes)]
    st.success(f"Best silhouette score K = **{best_k}** | You selected K = **{n_clusters}**")

    # Save to session
    st.session_state["X"] = X
    st.session_state["X_raw"] = X_raw
    st.session_state["sel_features"] = sel_features

