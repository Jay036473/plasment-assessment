    st.markdown('<div class="section-header">Cluster Visualization</div>', unsafe_allow_html=True)
    with st.spinner(f"Computing {use_dr}..."):
        if use_dr == "PCA":
            reducer = PCA(n_components=2, random_state=42)
            coords = reducer.fit_transform(X)
            var = reducer.explained_variance_ratio_
            ax_labels = [f"PC1 ({var[0] * 100:.1f}%)", f"PC2 ({var[1] * 100:.1f}%)"]
        else:
            n_sample = min(2000, len(X))
            idx_sample = np.random.choice(len(X), n_sample, replace=False)
            reducer = TSNE(n_components=2, perplexity=tsne_perp, random_state=42)
            coords_full = np.zeros((len(X), 2))
            coords_full[idx_sample] = reducer.fit_transform(X[idx_sample])
            coords = coords_full
            ax_labels = ["t-SNE 1", "t-SNE 2"]

    plot_df = pd.DataFrame(coords, columns=ax_labels)
    plot_df["Cluster"] = km_labels.astype(str)

    fig_vis = px.scatter(plot_df, x=ax_labels[0], y=ax_labels[1],
                         color="Cluster", title=f"K-Means Clusters — {use_dr}",
                         color_discrete_sequence=px.colors.qualitative.Bold,
                         opacity=0.7)
    fig_vis.update_layout(height=480)
    st.plotly_chart(fig_vis, use_container_width=True)

    # Cluster profile — ALL numeric columns
